{
  "name": "@portal/athena",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:be": "tsc --project ./tsconfig.server.json && tsc-alias --project ./tsconfig.server.json --resolve-full-paths",
    "build": "npm run build:be",
    "check:ts": "tsc --noEmit -p ./tsconfig.server.json",
    "test": "playwright test -c ./playwright.config.ts",
    "test:ui": "playwright test -c ./playwright.config.ts --ui",
    "watch:be": "nodemon --config ./nodemon.json",
    "watch": "npm run watch:be",
    "start": "NODE_USE_ENV_PROXY=1 node --enable-source-maps dist/server.js"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "nodemon": "3.1.11",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "express": "5.1.0"
  }
}
