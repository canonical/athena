{
  "name": "@portal/athena",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:fe": "vite build --config ./vite.config.ts",
    "dev:fe": "vite --config ./vite.config.ts --host 0.0.0.0 --port 5173",
    "build:be": "tsc --project ./tsconfig.server.json && tsc-alias --project ./tsconfig.server.json --resolve-full-paths",
    "build": "npm run build:be && npm run build:fe",
    "check:biome": "biome check",
    "check:ts": "tsc --noEmit -p ./tsconfig.server.json",
    "check": "npm run check:biome && npm run check:ts",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome ci",
    "test": "playwright test -c ./playwright.config.ts",
    "test:coverage": "COVERAGE=true playwright test -c ./playwright.config.ts",
    "test:ci": "npm run coverage:clean && COVERAGE=true playwright test -c ./playwright.config.ts; test_status=$?; npm run coverage:report; report_status=$?; if [ $test_status -ne 0 ]; then exit $test_status; fi; exit $report_status",
    "test:ui": "playwright test -c ./playwright.config.ts --ui",
    "coverage:clean": "rm -rf ./testing/output",
    "coverage:report": "nyc report --all --nycrc-path ./testing/.nycrc.json --temp-dir ./testing/output/.nyc_merged --reporter=text-summary --reporter=lcov --reporter=html --reporter=cobertura --reporter=json-summary --report-dir ./testing/output/coverage --exclude-after-remap=false",
    "watch:be": "nodemon --config ./nodemon.json",
    "watch": "npm run watch:be",
    "coverage:start": "NODE_OPTIONS='--loader @istanbuljs/esm-loader-hook' nyc --silent --cwd . --reporter=json --temp-dir .nyc_output node dist/server.js",
    "start": "NODE_USE_ENV_PROXY=1 node --enable-source-maps dist/server.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@istanbuljs/esm-loader-hook": "0.3.0",
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "istanbul-lib-coverage": "3.2.2",
    "nodemon": "^3.1.14",
    "nyc": "18.0.0",
    "sass": "^1.100.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "dependencies": {
    "@canonical/react-components": "^4.5.4",
    "express": "^5.2.1",
    "formik": "^2.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vanilla-framework": "^4.51.0"
  }
}
