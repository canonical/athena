{
  "name": "@canonical/athena",
  "version": "1.1.3",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:fe": "vite build --config ./vite.config.ts",
    "build:be": "tsc --project ./tsconfig.server.json && tsc-alias --project ./tsconfig.server.json --resolve-full-paths",
    "build": "npm run build:be && npm run build:fe",
    "check:biome": "biome check",
    "check:deprecations": "node ./scripts/check-deprecations.mjs",
    "check:ts:be": "tsc --noEmit -p ./tsconfig.server.json",
    "check:ts:fe": "tsc --noEmit -p ./tsconfig.json",
    "check:ts": "npm run check:ts:be && npm run check:ts:fe",
    "check": "npm run check:deprecations && npm run check:biome && npm run check:ts",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome ci",
    "test": "playwright test -c ./playwright.config.ts",
    "test:coverage": "COVERAGE=true playwright test -c ./playwright.config.ts",
    "test:ci": "npm run coverage:clean && CI=true COVERAGE=true playwright test -c ./playwright.config.ts; test_status=$?; npm run coverage:report; report_status=$?; if [ $test_status -ne 0 ]; then exit $test_status; fi; exit $report_status",
    "test:ui": "playwright test -c ./playwright.config.ts --ui",
    "coverage:clean": "rm -rf ./testing/results",
    "coverage:report": "nyc report --all --nycrc-path ./testing/.nycrc.json --temp-dir ./testing/results/.nyc_merged --reporter=text-summary --reporter=lcov --reporter=html --reporter=cobertura --reporter=json-summary --report-dir ./testing/results/coverage --exclude-after-remap=false",
    "watch:fe": "vite build --config ./vite.config.ts --watch",
    "watch:be": "nodemon --config ./nodemon.json",
    "watch": "sh -c 'npm run watch:fe & npm run watch:be & wait'",
    "coverage:start": "NODE_OPTIONS='--loader @istanbuljs/esm-loader-hook' nyc --silent --cwd . --reporter=json --temp-dir .nyc_output node dist/server.js",
    "start": "NODE_USE_ENV_PROXY=1 node --enable-source-maps dist/server.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@istanbuljs/esm-loader-hook": "0.3.0",
    "@playwright/test": "1.62.1",
    "@types/compression": "1.8.1",
    "@types/cookie-session": "2.0.49",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/passport": "1.0.17",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "istanbul-lib-coverage": "3.2.2",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
    "sass": "1.102.0",
    "tsc-alias": "1.9.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-compression2": "2.5.3",
    "vite-plugin-istanbul": "9.0.1"
  },
  "dependencies": {
    "@canonical/react-components": "4.8.2",
    "@microlink/react-json-view": "1.31.28",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "compression": "1.8.1",
    "cookie-session": "2.1.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "formik": "2.4.9",
    "openid-client": "6.8.4",
    "passport": "0.7.0",
    "pg": "8.22.0",
    "pino-http": "11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "uuid": "14.0.1",
    "vanilla-framework": "4.55.1",
    "zod": "4.4.3"
  }
}
