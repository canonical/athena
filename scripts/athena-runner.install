#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive
apt update
apt full-upgrade -y
apt install -y git snapd

if [ -d /opt/athena/.git ]; then
	git -C /opt/athena pull --ff-only
else
	git clone https://github.com/canonical/athena.git /opt/athena
fi

snap install lxd
snap install --classic workshop
snap install node --channel=24/stable --classic
snap refresh

cd /opt/athena
git fetch origin main
git checkout main
git reset --hard origin/main

install -m 0644 /opt/athena/scripts/athena-runner.service /etc/systemd/system/athena-runner.service
install -m 0755 /opt/athena/scripts/athenaconfigure /usr/local/bin/athenaconfigure
install -m 0755 /opt/athena/scripts/athena-runner.prepare /usr/local/sbin/athena-runner-prepare
if [ ! -e /etc/athena-runner.env ]; then
	install -m 0600 /dev/null /etc/athena-runner.env
fi
systemctl daemon-reload
systemctl enable athena-runner.service
systemctl restart athena-runner.service