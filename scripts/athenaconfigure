#!/bin/sh
set -eu

ENV_FILE=/etc/athena-runner.env

usage() {
  cat <<'EOF'
Usage:
  athenaconfigure --url URL [--branch BRANCH] [token]

Options:
  --url URL          Set the Athena URL.
  --branch BRANCH    Set the Git branch used by the runner.
  token              Prompt for and set the runner token.
EOF
}

if [ "$(id -u)" -ne 0 ]; then
  echo "athenaconfigure must be run as root (use sudo)." >&2
  exit 1
fi

url=
branch=
token=
set_token=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --url)
      [ "$#" -ge 2 ] || { echo "--url requires a value." >&2; exit 1; }
      url=$2
      shift 2
      ;;
    --branch)
      [ "$#" -ge 2 ] || { echo "--branch requires a value." >&2; exit 1; }
      branch=$2
      shift 2
      ;;
    token)
      printf 'Athena runner token: ' >&2
      stty -echo
      read -r token
      stty echo
      printf '\n' >&2
      set_token=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

[ -n "$url" ] && case "$url" in
  *[!A-Za-z0-9:/._-]*) echo "Invalid URL." >&2; exit 1 ;;
esac
[ -n "$url" ] || { echo "--url is required." >&2; usage >&2; exit 1; }
[ -n "$branch" ] || branch=
[ -n "$branch" ] && case "$branch" in
  -*|*[!A-Za-z0-9._/-]*) echo "Invalid branch name." >&2; exit 1 ;;
esac

mkdir -p "$(dirname "$ENV_FILE")"
touch "$ENV_FILE"
chmod 0600 "$ENV_FILE"

sed -i '/^ATHENA_URL=/d' "$ENV_FILE"
printf 'ATHENA_URL=%s\n' "$url" >> "$ENV_FILE"
if [ -n "$branch" ]; then
  sed -i '/^ATHENA_RUNNER_BRANCH=/d' "$ENV_FILE"
  printf 'ATHENA_RUNNER_BRANCH=%s\n' "$branch" >> "$ENV_FILE"
fi
if [ "$set_token" -eq 1 ]; then
  sed -i '/^ATHENA_RUNNER_TOKEN=/d' "$ENV_FILE"
  printf 'ATHENA_RUNNER_TOKEN=%s\n' "$token" >> "$ENV_FILE"
fi

systemctl restart athena-runner.service
