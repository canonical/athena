APP_ATHENA_OIDC_CLIENT_ID=athena
APP_ATHENA_OIDC_CLIENT_SECRET=super-secret-value
APP_ATHENA_SECRET_KEY=replace-with-a-long-random-session-secret
APP_ATHENA_SESSION_MAX_AGE=86400000
APP_ATHENA_ALLOWED_ORIGINS=http://athena.localhost
APP_ATHENA_FRONTEND_BASE_URL=http://athena.localhost

# Frontend API host (set for split-host deployments)
VITE_API_BASE_URL=http://athenabe.localhost
