POSTGRES_PASSWORD=changeme
APP_ATHENA_POSTGRESQL_DB_CONNECT_STRING=postgresql://athena:changeme@postgres:5432/athena

APP_ATHENA_PORT=8000
APP_ATHENA_DEV_MODE=true

# Public hostname Traefik routes to Athena and /dex (in addition to athena.localhost).
APP_ATHENA_PUBLIC_HOST=yourhostname.lclhst.stream

# OIDC authentication
APP_ATHENA_OAUTH_CALLBACK_URL=http://athena.localhost/api/authentication/callback
APP_ATHENA_DEX_EXTRA_REDIRECT_URIS=
APP_ATHENA_OIDC_DISCOVERY_URL=http://dex.localhost/dex/.well-known/openid-configuration
APP_ATHENA_OIDC_CLIENT_ID=athena
APP_ATHENA_OIDC_CLIENT_SECRET=super-secret-value
APP_ATHENA_SECRET_KEY=replace-with-a-long-random-session-secret
APP_ATHENA_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-credential-encryption-secret
APP_ATHENA_SESSION_MAX_AGE=86400000
APP_ATHENA_ALLOWED_ORIGINS=http://athena.localhost
APP_ATHENA_FRONTEND_BASE_URL=http://athena.localhost

# Frontend API base path for same-host backend routing
VITE_API_BASE_URL=/api

# Optional Cloudflare managed tunnel token for cloudflared.
# Set this to enable: docker compose up -d cloudflared
CLOUDFLARED_TUNNEL_TOKEN=

